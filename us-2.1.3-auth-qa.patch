diff --git a/tests/auth-callback.test.mjs b/tests/auth-callback.test.mjs
new file mode 100644
index 0000000..ef85bb5
--- /dev/null
+++ b/tests/auth-callback.test.mjs
@@ -0,0 +1,97 @@
+// Tests for GET /api/auth/callback (US 2.1.3 #2, OAuth) — run with `npm test`
+// Supabase is mocked; the route's redirect logic is the real code.
+import { register } from 'node:module'
+import { test, mock, beforeEach, describe } from 'node:test'
+import assert from 'node:assert/strict'
+
+const ROOT = new URL('../', import.meta.url).href
+register(
+  'data:text/javascript,' +
+    encodeURIComponent(`export async function resolve(s, c, next) {
+      if (s.startsWith('@/')) return next(new URL(s.slice(2) + '.ts', ${JSON.stringify(ROOT)}).href, c)
+      if (s === 'next/headers') return next('next/headers.js', c)
+      return next(s, c)
+    }`)
+)
+
+let exchangeResult
+const exchangeCodeForSession = mock.fn(async () => exchangeResult)
+
+mock.module('next/headers', { namedExports: { cookies: async () => ({}) } })
+mock.module('@/utils/supabase/server', {
+  namedExports: { createClient: () => ({ auth: { exchangeCodeForSession } }) },
+})
+
+const { GET } = await import('../app/api/auth/callback/route.ts')
+
+const ORIGIN = 'http://localhost:3000'
+
+async function callback(query, headers = {}) {
+  const res = await GET(new Request(`${ORIGIN}/api/auth/callback${query}`, { headers }))
+  return { status: res.status, location: res.headers.get('location') }
+}
+
+beforeEach(() => {
+  exchangeResult = { error: null }
+  exchangeCodeForSession.mock.resetCalls()
+  process.env.NODE_ENV = 'test'
+})
+
+describe('successful sign-in', () => {
+  test('exchanges the code and sends the user home', async () => {
+    const r = await callback('?code=abc')
+    assert.equal(exchangeCodeForSession.mock.callCount(), 1)
+    assert.equal(exchangeCodeForSession.mock.calls[0].arguments[0], 'abc')
+    assert.equal(r.status, 307)
+    assert.equal(r.location, `${ORIGIN}/`)
+  })
+
+  test('returns the user to `next` (e.g. "Sign in to reserve")', async () => {
+    const r = await callback('?code=abc&next=' + encodeURIComponent('/reserve/hotel-1?nights=3'))
+    assert.equal(r.location, `${ORIGIN}/reserve/hotel-1?nights=3`)
+  })
+
+  test('ignores an absolute `next` URL (no open redirect)', async () => {
+    const r = await callback('?code=abc&next=' + encodeURIComponent('https://evil.example'))
+    assert.equal(r.location, `${ORIGIN}/`)
+  })
+
+  for (const evil of ['//evil.example', '/\\evil.example']) {
+    test(`keeps a protocol-relative \`next\` (${evil}) on our own host`, async () => {
+      const r = await callback('?code=abc&next=' + encodeURIComponent(evil))
+      assert.equal(new URL(r.location).host, 'localhost:3000')
+    })
+  }
+
+  test('uses x-forwarded-host in production', async () => {
+    process.env.NODE_ENV = 'production'
+    const r = await callback('?code=abc&next=/MyBookings', { 'x-forwarded-host': 'likehome.app' })
+    assert.equal(r.location, 'https://likehome.app/MyBookings')
+  })
+
+  test('ignores x-forwarded-host in development', async () => {
+    process.env.NODE_ENV = 'development'
+    const r = await callback('?code=abc', { 'x-forwarded-host': 'likehome.app' })
+    assert.equal(r.location, `${ORIGIN}/`)
+  })
+})
+
+describe('failed sign-in', () => {
+  test('no code (user cancelled at the provider) → error page', async () => {
+    const r = await callback('?error=access_denied&error_description=cancelled')
+    assert.equal(exchangeCodeForSession.mock.callCount(), 0)
+    assert.equal(r.location, `${ORIGIN}/auth/error`)
+  })
+
+  test('code exchange fails → error page', async () => {
+    exchangeResult = { error: { message: 'invalid grant' } }
+    const r = await callback('?code=expired')
+    assert.equal(r.location, `${ORIGIN}/auth/error`)
+  })
+
+  test('error page keeps `next` so "Try again" returns the user there', async () => {
+    exchangeResult = { error: { message: 'invalid grant' } }
+    const r = await callback('?code=expired&next=/reserve/hotel-1')
+    assert.equal(r.location, `${ORIGIN}/auth/error?next=${encodeURIComponent('/reserve/hotel-1')}`)
+  })
+})
diff --git a/tests/auth-proxy.test.mjs b/tests/auth-proxy.test.mjs
new file mode 100644
index 0000000..555be8d
--- /dev/null
+++ b/tests/auth-proxy.test.mjs
@@ -0,0 +1,71 @@
+// Tests for the Supabase session check in proxy.ts / utils/supabase/middleware.ts — run with `npm test`
+import { register } from 'node:module'
+import { test, mock, beforeEach, describe } from 'node:test'
+import assert from 'node:assert/strict'
+
+const ROOT = new URL('../', import.meta.url).href
+register(
+  'data:text/javascript,' +
+    encodeURIComponent(`export async function resolve(s, c, next) {
+      if (s.startsWith('@/')) return next(new URL(s.slice(2) + '.ts', ${JSON.stringify(ROOT)}).href, c)
+      if (s === 'next/server') return next('next/server.js', c)
+      return next(s, c)
+    }`)
+)
+
+let claims
+const getClaims = mock.fn(async () => ({ data: claims ? { claims } : null, error: null }))
+const getUser = mock.fn(async () => ({ data: { user: null }, error: null }))
+
+mock.module('@supabase/ssr', {
+  namedExports: { createServerClient: () => ({ auth: { getClaims, getUser } }) },
+})
+
+const { NextRequest } = await import('next/server.js')
+const { proxy } = await import('../proxy.ts')
+
+const req = (path) => new NextRequest(`http://localhost:3000${path}`)
+
+beforeEach(() => {
+  claims = null
+  getClaims.mock.resetCalls()
+  getUser.mock.resetCalls()
+})
+
+describe('protected routes', () => {
+  test('signed-out user on /protected/* is sent to the login page', async () => {
+    const res = await proxy(req('/protected/account'))
+    assert.equal(res.status, 307)
+    assert.equal(new URL(res.headers.get('location')).pathname, '/auth/login')
+  })
+
+  test('signed-in user on /protected/* passes through', async () => {
+    claims = { sub: 'user-1' }
+    const res = await proxy(req('/protected/account'))
+    assert.equal(res.headers.get('location'), null)
+  })
+
+  test('public pages pass through when signed out', async () => {
+    for (const path of ['/', '/search', '/auth/login']) {
+      const res = await proxy(req(path))
+      assert.equal(res.headers.get('location'), null, path)
+    }
+  })
+
+  test('login redirect keeps the page the user wanted as ?next=', { todo: 'BUG: proxy drops the original path' }, async () => {
+    const res = await proxy(req('/protected/account'))
+    assert.equal(new URL(res.headers.get('location')).searchParams.get('next'), '/protected/account')
+  })
+})
+
+describe('session check cost', () => {
+  test('only one auth call per request', { todo: 'PERF: getUser() runs after getClaims() on every request' }, async () => {
+    await proxy(req('/'))
+    assert.equal(getClaims.mock.callCount() + getUser.mock.callCount(), 1)
+  })
+})
+
+test('/mybookings in other casing redirects to /MyBookings', async () => {
+  const res = await proxy(req('/mybookings'))
+  assert.equal(new URL(res.headers.get('location')).pathname, '/MyBookings')
+})
